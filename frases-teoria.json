  {
   "id": "finales",
   "grupo": "frases",
   "icono": "💬",
   "titulo": "Partículas finales: よ ね さ の かな",
   "explicacion": [
    "よ: informa o enfatiza («¡te lo digo!»): 行くよ。",
    "ね: busca acuerdo («¿verdad?»): 暑いね。",
    "さ: relleno informal, como «¿sabes?»: 忙しくてさ。",
    "の: pregunta suave o explicación: どうしたの？",
    "かな: preguntarse a uno mismo: いいかな。"
   ],
   "ejemplos": [
    {
     "ja": "行くよ。",
     "lectura": "iku yo",
     "es": "Voy (¡que lo sepas!)."
    },
    {
     "ja": "暑いね。",
     "lectura": "atsui ne",
     "es": "Hace calor, ¿eh?"
    },
    {
     "ja": "どうしたの？",
     "lectura": "dō shita no?",
     "es": "¿Qué te pasa?"
    }
   ],
   "ejercicios": [
    {
     "id": "finales-1",
     "p": "Quieres informar con énfasis: 行く＿。",
     "ja": "行く＿。",
