  {
   "id": "contracciones",
   "grupo": "frases",
   "icono": "✂️",
   "titulo": "Contracciones habladas",
   "explicacion": [
    "している → してる (ている pierde la い).",
    "~てしまう → ~ちゃう; ~でしまう → ~じゃう. Indica algo hecho sin querer o del todo: 忘れちゃった。",
    "~ておく → ~とく: 閉じとく, しとく。",
    "のだ → んだ / んの: そうなんだ。",
    "分からない → 分かんない (ない tras ん)."
   ],
   "ejemplos": [
    {
     "ja": "何してる？",
     "lectura": "nani shiteru?",
     "es": "¿Qué haces?"
    },
    {
     "ja": "忘れちゃった。",
     "lectura": "wasurechatta",
     "es": "Se me olvidó."
    },
    {
     "ja": "やめとく。",
     "lectura": "yametoku",
     "es": "Mejor lo dejo."
    }
   ],
   "ejercicios": [
    {
     "id": "contracciones-1",
     "p": "何してる？ viene de…",
     "ja": "何してる？",
     "ops": [
      "何している？",
      "何した？",
      "何する？"
     ],
     "ok": 0,
     "exp": "してる = している."
    },
    {
     "id": "contracciones-2",
     "p": "忘れてしまった en coloquial es…",
     "ja": "",
     "ops": [
      "忘れちゃった",
      "忘れとった",
      "忘れてる"
     ],
     "ok": 0,
     "exp": "てしまった → ちゃった."
    },
    {
     "id": "contracciones-3",
     "p": "食べておく en coloquial es…",
     "ja": "",
     "ops": [
      "食べとく",
      "食べちゃう",
      "食べてる"
     ],
     "ok": 0,
     "exp": "ておく → とく."
    },
    {
     "id": "contracciones-4",
     "p": "閉じてしまう en coloquial es…",
     "ja": "",
     "ops": [
      "閉じちゃう",
      "閉じとく",
      "閉じてる"
     ],
     "ok": 0,
     "exp": "てしまう → ちゃう."
    },
    {
     "id": "contracciones-5",
     "p": "分からない en coloquial es…",
     "ja": "",
     "ops": [
      "分かんない",
      "分かった",
      "分かる"
     ],
     "ok": 0,
     "exp": "ない tras ら suele pasar a んない."
    },
    {
     "id": "contracciones-6",
     "p": "¿Qué significa 寝坊しちゃった。?",
