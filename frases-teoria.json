     "ops": [
      "を",
      "に",
      "で"
     ],
     "ok": 0,
     "exp": "を: 水をください."
    },
    {
     "id": "particulas-6",
     "p": "En 水ちょうだい。 falta を. ¿Es correcto hablando?",
